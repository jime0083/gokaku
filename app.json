{
  "expo": {
    "name": "gokaku",
    "slug": "gokaku",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gokaku",
    "userInterfaceStyle": "light",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "com.jime0083.gokakuwatch",
      "appleTeamId": "78G6667N9J",
      "supportsTablet": false,
      "infoPlist": {
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.jime0083.gokakuwatch"],
        "keychain-access-groups": ["$(AppIdentifierPrefix)group.com.jime0083.gokakuwatch"]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
