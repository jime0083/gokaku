{
  "expo": {
    "name": "gokaku",
    "slug": "gokaku",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gokaku",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "com.jime0083.gokakuwatch",
      "appleTeamId": "78G6667N9J",
      "supportsTablet": false,
      "googleServicesFile": "./config/GoogleService-Info.emulator.plist",
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NativeSyncBaseURL": "$(NATIVE_SYNC_BASE_URL)"
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.jime0083.gokakuwatch"
        ],
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)group.com.jime0083.gokakuwatch"
        ]
      },
      "usesAppleSignIn": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "useFrameworks": "dynamic"
          }
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withNativeSyncBaseURL",
      "@react-native-community/datetimepicker",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-iap",
      "./plugins/withStoreKitConfig",
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
