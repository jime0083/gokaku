{
  "name": "gokaku",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "test-renderer": "~1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/rules && tsc --noEmit -p tests/lint && npm --prefix functions run typecheck",
    "test": "jest && npm run test:tz",
    "test:tz": "TZ=America/Los_Angeles jest shared && TZ=UTC jest shared",
    "emulators": "npm --prefix functions run build && firebase emulators:start",
    "test:functions": "npm --prefix functions run build && firebase emulators:exec --only functions,firestore \"npm --prefix functions test\"",
    "test:rules": "firebase emulators:exec --only firestore \"jest -c jest.rules.config.js\"",
    "e2e": "node scripts/e2e.js"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/shared",
      "<rootDir>/tests/lint"
    ]
  }
}
