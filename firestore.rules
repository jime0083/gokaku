rules_version = '2';

// アクセス権限方針(requirements.md 5)の最小版。
// - 本人は自分の users/{uid} 配下のみ読み取り可
// - 書き込みの細かい許可(設定・目標・セッション追記のみ等)は Phase 3-5 以降で順に追加する
// - それ以外(xTokens・appleSubscriptions・deviceTokens を含む)はクライアントから一切アクセス不可(デフォルト拒否。
//   明示的な match を書かないため、どの match にも当たらず拒否される。4-2a: appleSubscriptions はサーバー(Admin SDK)のみ読み書き可)
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // P-055: 削除開始後・親削除後のクライアント書込/再作成を拒否する。
    function canWriteUserData(uid) {
      return isOwner(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.get('deletionInProgress', false) != true;
    }

    // 数値が int/float のどちらであっても範囲チェックできるようにするヘルパー
    function isNumberInRange(value, minValue, maxValue) {
      return (value is int || value is float) && value >= minValue && value <= maxValue;
    }

    // 1日の最低・努力目標勉強時間(mokuhyo.txt 1: 10分〜960分、10分刻み)
    function isValidDailyMinutes(value) {
      return value is int && value >= 10 && value <= 960 && value % 10 == 0;
    }

    // 自由入力の文字列(mokuhyo.txt 1: 1〜50文字)
    function isValidFreeText(value) {
      return value is string && value.size() >= 1 && value.size() <= 50;
    }

    // 'YYYY-MM-DD' の日付キーが、実在する日付であるかの検査(problem P-021)。
    // timestamp.value(dateKey + 'T00:00:00+09:00') は閏日等の実在しない日付も丸めて成功してしまう
    // ことを Emulator で確認したため(2026-10-09)、年月日を分解して暦として検査する方式にする
    function isLeapYear(year) {
      return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
    }

    function daysInMonth(year, month) {
      return month == 2
        ? (isLeapYear(year) ? 29 : 28)
        : ((month == 4 || month == 6 || month == 9 || month == 11) ? 30 : 31);
    }

    // 文字列かつ 'YYYY-MM-DD' の形式か(isCalendarDate で年月日に分解する前に、
    // && の短絡評価で文字列以外(split 等が使えない値)を弾く)
    function isDateKeyShaped(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // 'YYYY-MM-DD' 形式の文字列を暦として検査する(isDateKeyShaped が true のものにだけ使う)
    function isCalendarDate(value) {
      let parts = value.split('-');
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      return month >= 1 && month <= 12 && day >= 1 && day <= daysInMonth(year, month);
    }

    // 'YYYY-MM-DD' かつ実在する日付の文字列か
    function isRealDateKey(value) {
      return isDateKeyShaped(value) && isCalendarDate(value);
    }

    // 日付キーを年月日の比較用の整数値にする(isRealDateKey で実在することを確認済みのものに対して使う)
    function dateKeyValue(value) {
      let parts = value.split('-');
      return int(parts[0]) * 10000 + int(parts[1]) * 100 + int(parts[2]);
    }

    // request.time(UTC)を日本時間の日付キーの比較用整数値にする
    function jstTodayValue() {
      let jstNow = request.time + duration.value(9, 'h');
      return jstNow.year() * 10000 + jstNow.month() * 100 + jstNow.day();
    }

    // goals ドキュメントの型に関わらない共通フィールドのチェック(mokuhyo.txt 1, requirements 5)。
    // startDate は書き込み時点の日本時間の今日、examDate は startDate より後の実在する日付であること(problem P-021)
    function isValidGoalCommonFields(data) {
      return data.status == 'active'
        && data.targetHours is int && data.targetHours >= 1 && data.targetHours <= 20000
        && isRealDateKey(data.examDate)
        && isRealDateKey(data.startDate)
        && dateKeyValue(data.startDate) == jstTodayValue()
        && dateKeyValue(data.examDate) > dateKeyValue(data.startDate)
        && isValidDailyMinutes(data.minDailyMinutes)
        && isValidDailyMinutes(data.goalDailyMinutes)
        && data.goalDailyMinutes >= data.minDailyMinutes
        && 'estimatedHours' in data
        && 'createdAt' in data;
    }

    // 受験ルートの goal ドキュメント(requirements 4-2, 5)
    function isValidExamGoal(data) {
      return data.type == 'exam'
        && data.keys().hasOnly([
          'type', 'university', 'targetDeviation', 'currentDeviation', 'subjectCount',
          'estimatedHours', 'targetHours', 'examDate', 'minDailyMinutes', 'goalDailyMinutes',
          'startDate', 'status', 'createdAt',
        ])
        && isValidFreeText(data.university)
        && isValidEditDeviation(data.targetDeviation)
        && isValidEditDeviation(data.currentDeviation)
        && data.subjectCount is int && data.subjectCount >= 1 && data.subjectCount <= 8
        && isValidGoalCommonFields(data);
    }

    // 資格ルートの goal ドキュメント(requirements 4-3, 5)。「その他」の certId は OTHER_CERTIFICATION_ID('other'。
    // src/features/onboarding/types.ts)。その場合のみ certOtherName は 1〜50文字、それ以外は空文字を許す
    function isValidCertGoal(data) {
      return data.type == 'cert'
        && data.keys().hasOnly([
          'type', 'certId', 'certOtherName',
          'estimatedHours', 'targetHours', 'examDate', 'minDailyMinutes', 'goalDailyMinutes',
          'startDate', 'status', 'createdAt',
        ])
        && data.certId is string && data.certId.size() >= 1
        && data.certOtherName is string && data.certOtherName.size() <= 50
        && (data.certId != 'other' || data.certOtherName.size() >= 1)
        && isValidGoalCommonFields(data);
    }

    // 6-2a / P-048: Both creation and numeric edits use the same deviation precision validation.
    // Shared deviationToTenths allows floating-point error <= 1e-6 in deviation units.
    function isValidEditDeviation(value) {
      return isNumberInRange(value, 25.0, 80.0)
        && math.abs(math.round(value * 10) / 10.0 - value) <= 0.000001;
    }

    function isValidGoalNumericUpdate(uid, goalId) {
      let after = request.resource.data;
      let changed = after.diff(resource.data).affectedKeys();
      let parent = get(/databases/$(database)/documents/users/$(uid)).data;
      return resource.data.status == 'active'
        && parent.activeGoalId == goalId
        && changed.hasOnly(resource.data.type == 'exam'
          ? ['targetHours', 'examDate', 'minDailyMinutes', 'goalDailyMinutes', 'targetDeviation', 'currentDeviation', 'subjectCount']
          : ['targetHours', 'examDate', 'minDailyMinutes', 'goalDailyMinutes'])
        && after.targetHours is int && after.targetHours >= 1 && after.targetHours <= 20000
        && isRealDateKey(after.examDate) && dateKeyValue(after.examDate) > jstTodayValue()
        && isValidDailyMinutes(after.minDailyMinutes) && isValidDailyMinutes(after.goalDailyMinutes)
        && after.goalDailyMinutes >= after.minDailyMinutes
        && ((resource.data.type == 'cert') || (resource.data.type == 'exam'
          && isValidEditDeviation(after.targetDeviation) && isValidEditDeviation(after.currentDeviation)
          && after.subjectCount is int && after.subjectCount >= 1 && after.subjectCount <= 8))
        && (hasNoGoalHistoryMetadata(parent)
          || isGoalEditWithParentCounterUpdate(uid, goalId));
    }

    // 6-3a: A pointer change always designates a brand-new active goal in this commit.
    // Reads are cached across the three writes (user + old goal + new goal).
    function isValidGoalPointerTransition(uid, newId) {
      let oldId = get(/databases/$(database)/documents/users/$(uid)).data.get('activeGoalId', null);
      return newId is string && newId.size() > 0 && newId != oldId
        && !exists(/databases/$(database)/documents/users/$(uid)/goals/$(newId))
        && getAfter(/databases/$(database)/documents/users/$(uid)/goals/$(newId)).data.status == 'active'
        && (oldId == null || (oldId is string && oldId.size() > 0
          && get(/databases/$(database)/documents/users/$(uid)/goals/$(oldId)).data.status == 'active'
          && getAfter(/databases/$(database)/documents/users/$(uid)/goals/$(oldId)).data.status == 'replaced'
          && getAfter(/databases/$(database)/documents/users/$(uid)/goals/$(oldId)).data
            .diff(get(/databases/$(database)/documents/users/$(uid)/goals/$(oldId)).data).affectedKeys().hasOnly(['status'])));
    }

    // 7-2-C: metadataのないlegacyと、壊れた部分metadataを区別する。
    function hasNoGoalHistoryMetadata(data) {
      return !data.keys().hasAny(['judgementHistoryStartedAt', 'judgementRevisions']);
    }

    function isPositiveSafeRevision(value) {
      return value is int && value > 0 && value <= 9007199254740991;
    }

    function isGoalHistoryInitialized(data) {
      let revisions = data.get('judgementRevisions', null);
      return data.get('judgementHistoryStartedAt', null) is timestamp
        && revisions is map
        && revisions.keys().hasAll(['goal', 'settings', 'xLink', 'subscription'])
        && isPositiveSafeRevision(revisions.goal)
        && isPositiveSafeRevision(revisions.settings)
        && isPositiveSafeRevision(revisions.xLink)
        && isPositiveSafeRevision(revisions.subscription);
    }

    // 7-2-C / P-122: 完全な履歴整合検査は親user更新から一度だけ呼ぶ。
    // 呼出側でbeforeの初期化metadataと初回pointer遷移を検査済み。
    function isValidInitialGoalHistory(uid, goalId) {
      let beforeUser = get(/databases/$(database)/documents/users/$(uid)).data;
      let afterUser = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      let revision = beforeUser.judgementRevisions.goal + 1;
      let entryPath = /databases/$(database)/documents/users/$(uid)/judgementHistory/goal/entries/$(string(revision));
      let entry = getAfter(entryPath).data;
      let goal = getAfter(/databases/$(database)/documents/users/$(uid)/goals/$(goalId)).data;
      return afterUser.judgementHistoryStartedAt == beforeUser.judgementHistoryStartedAt
        && isPositiveSafeRevision(afterUser.judgementRevisions.goal)
        && afterUser.judgementRevisions.goal == revision
        && afterUser.judgementRevisions.diff(beforeUser.judgementRevisions)
          .affectedKeys().hasOnly(['goal'])
        && !exists(entryPath)
        && entry.keys().hasOnly(['schemaVersion', 'revision', 'committedAt', 'before', 'after'])
        && entry.schemaVersion == 1
        && entry.revision is int && entry.revision == revision
        && entry.committedAt == request.time
        && entry.before == null
        && entry.after == {
          'goalId': goalId,
          'startDate': goal.startDate,
          'examDate': goal.examDate,
          'minDailyMinutes': goal.minDailyMinutes,
          'goalDailyMinutes': goal.goalDailyMinutes
        };
    }

    // 親userの初回pointer更新専用。legacyも従来の許可フィールドを維持する。
    function isValidInitialGoalRegistration(uid, goalId, changed) {
      return isValidGoalPointerTransition(uid, goalId)
        && (hasNoGoalHistoryMetadata(resource.data)
          ? changed.hasOnly(['activeGoalId', 'checkEnabled', 'xPostEnabled'])
          : (isGoalHistoryInitialized(resource.data)
            && changed.hasOnly(['activeGoalId', 'checkEnabled', 'xPostEnabled', 'judgementRevisions'])
            && isValidInitialGoalHistory(uid, goalId)));
    }

    function isValidGoalCreation(uid, goalId) {
      let parent = get(/databases/$(database)/documents/users/$(uid)).data;
      let oldId = parent.get('activeGoalId', null);
      return getAfter(/databases/$(database)/documents/users/$(uid)).data.activeGoalId == goalId
        // 初回の親allowは従来どおり。初期化済み置換は実pointer/counter変更を強制する。
        && (oldId == null || (hasNoGoalHistoryMetadata(parent)
          ? isValidGoalPointerTransition(uid, goalId)
          : isGoalReplacementWithParentUpdate(uid)));
    }

    // entry自身のcanonical IDと親の実変更だけを検査する。
    // before=null / after=非空文字列により親updateのallow通過が不可欠。
    // 親はこのIDのgetAfter(entry)全体を検査するため、payload検査を重複しない。
    function isInitialGoalHistoryEntryWithParentUpdate(uid, entryId) {
      let beforeUser = get(/databases/$(database)/documents/users/$(uid)).data;
      let afterUser = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return beforeUser.get('activeGoalId', null) == null
        && afterUser.get('activeGoalId', null) is string
        && afterUser.activeGoalId.size() > 0
        && beforeUser.judgementRevisions.goal is int
        && afterUser.judgementRevisions.goal is int
        && afterUser.judgementRevisions.goal == beforeUser.judgementRevisions.goal + 1
        && entryId == string(afterUser.judgementRevisions.goal);
    }

    // 7-2-D: full payload検査は親counter更新のallowだけで実行する。
    function goalHistoryProjection(goalId, goal) {
      return {
        'goalId': goalId,
        'startDate': goal.startDate,
        'examDate': goal.examDate,
        'minDailyMinutes': goal.minDailyMinutes,
        'goalDailyMinutes': goal.goalDailyMinutes
      };
    }

    function isValidGoalEditHistory(uid) {
      let beforeUser = resource.data;
      let afterUser = request.resource.data;
      let goalId = beforeUser.get('activeGoalId', null);
      let revision = beforeUser.judgementRevisions.goal + 1;
      let beforeGoal = get(/databases/$(database)/documents/users/$(uid)/goals/$(goalId)).data;
      let afterGoal = getAfter(/databases/$(database)/documents/users/$(uid)/goals/$(goalId)).data;
      let entryPath = /databases/$(database)/documents/users/$(uid)/judgementHistory/goal/entries/$(string(revision));
      let entry = getAfter(entryPath).data;
      return isGoalHistoryInitialized(beforeUser)
        && goalId is string && goalId.size() > 0
        && afterUser.get('activeGoalId', null) == goalId
        && beforeGoal.status == 'active' && afterGoal.status == 'active'
        && (beforeGoal.type == 'exam' || beforeGoal.type == 'cert')
        && afterGoal.type == beforeGoal.type
        && afterUser.judgementHistoryStartedAt == beforeUser.judgementHistoryStartedAt
        && isPositiveSafeRevision(afterUser.judgementRevisions.goal)
        && afterUser.judgementRevisions.goal == revision
        && afterUser.judgementRevisions.diff(beforeUser.judgementRevisions)
          .affectedKeys().hasOnly(['goal'])
        && !exists(entryPath)
        && entry.keys().hasOnly(['schemaVersion', 'revision', 'committedAt', 'before', 'after'])
        && entry.schemaVersion == 1
        && entry.revision is int && entry.revision == revision
        && entry.committedAt == request.time
        && entry.before == goalHistoryProjection(goalId, beforeGoal)
        && entry.after == goalHistoryProjection(goalId, afterGoal);
    }

    // counterの実変更により親updateのallow通過を必須にする。
    // canonical entryの存在だけを確認し、payload全体の検査は重複しない。
    function isGoalEditWithParentCounterUpdate(uid, goalId) {
      let beforeUser = get(/databases/$(database)/documents/users/$(uid)).data;
      let afterUser = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return beforeUser.get('activeGoalId', null) == goalId
        && afterUser.get('activeGoalId', null) == goalId
        && beforeUser.judgementRevisions.goal is int
        && afterUser.judgementRevisions.goal is int
        && afterUser.judgementRevisions.goal == beforeUser.judgementRevisions.goal + 1
        && getAfter(/databases/$(database)/documents/users/$(uid)/judgementHistory/goal/entries/$(string(afterUser.judgementRevisions.goal))).data.revision
          == afterUser.judgementRevisions.goal;
    }

    function isEditedGoalHistoryEntryWithParentUpdate(uid, entryId) {
      let beforeUser = get(/databases/$(database)/documents/users/$(uid)).data;
      let afterUser = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return beforeUser.get('activeGoalId', null) is string
        && beforeUser.activeGoalId.size() > 0
        && afterUser.get('activeGoalId', null) == beforeUser.activeGoalId
        && beforeUser.judgementRevisions.goal is int
        && afterUser.judgementRevisions.goal is int
        && afterUser.judgementRevisions.goal == beforeUser.judgementRevisions.goal + 1
        && entryId == string(afterUser.judgementRevisions.goal);
    }


    // 7-2内部作業: 置換のfull検査は親user更新で一度だけ実施する(P-122)。
    // pointer整合・旧statusのみ変更・新goalの不存在は呼出側で検査済み。
    function isValidGoalReplacementHistory(uid, newId) {
      let beforeUser = resource.data;
      let afterUser = request.resource.data;
      let oldId = beforeUser.activeGoalId;
      let revision = beforeUser.judgementRevisions.goal + 1;
      let oldGoal = get(/databases/$(database)/documents/users/$(uid)/goals/$(oldId)).data;
      let newGoal = getAfter(/databases/$(database)/documents/users/$(uid)/goals/$(newId)).data;
      let entryPath = /databases/$(database)/documents/users/$(uid)/judgementHistory/goal/entries/$(string(revision));
      let entry = getAfter(entryPath).data;
      return afterUser.judgementHistoryStartedAt == beforeUser.judgementHistoryStartedAt
        && isPositiveSafeRevision(afterUser.judgementRevisions.goal)
        && afterUser.judgementRevisions.goal == revision
        && afterUser.judgementRevisions.diff(beforeUser.judgementRevisions)
          .affectedKeys().hasOnly(['goal'])
        && !exists(entryPath)
        && entry.keys().hasOnly(['schemaVersion', 'revision', 'committedAt', 'before', 'after'])
        && entry.schemaVersion == 1
        && entry.revision is int && entry.revision == revision
        && entry.committedAt == request.time
        && entry.before == goalHistoryProjection(oldId, oldGoal)
        && entry.after == goalHistoryProjection(newId, newGoal);
    }

    function isValidGoalReplacementRegistration(uid, newId, changed) {
      return isValidGoalPointerTransition(uid, newId)
        && (hasNoGoalHistoryMetadata(resource.data)
          ? changed.hasOnly(['activeGoalId', 'checkEnabled', 'xPostEnabled'])
          : (isGoalHistoryInitialized(resource.data)
            && changed.hasOnly(['activeGoalId', 'judgementRevisions'])
            && isValidGoalReplacementHistory(uid, newId)));
    }

    // 新/旧goal側は親の実pointer/counter変更を必須化する。
    // 同commitの親allowがcanonical entryを含む全体整合を担う。
    function isGoalReplacementWithParentUpdate(uid) {
      let beforeUser = get(/databases/$(database)/documents/users/$(uid)).data;
      let afterUser = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      let oldId = beforeUser.get('activeGoalId', null);
      let newId = afterUser.get('activeGoalId', null);
      return oldId is string && oldId.size() > 0
        && newId is string && newId.size() > 0 && newId != oldId
        && beforeUser.judgementRevisions.goal is int
        && afterUser.judgementRevisions.goal is int
        && afterUser.judgementRevisions.goal == beforeUser.judgementRevisions.goal + 1;
    }

    function isReplacedGoalHistoryEntryWithParentUpdate(uid, entryId) {
      let afterUser = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return isGoalReplacementWithParentUpdate(uid)
        && entryId == string(afterUser.judgementRevisions.goal);
    }

    function isValidGoalReplacement(uid, goalId) {
      let parent = get(/databases/$(database)/documents/users/$(uid)).data;
      let nextId = getAfter(/databases/$(database)/documents/users/$(uid)).data.get('activeGoalId', null);
      return resource.data.status == 'active'
        && parent.activeGoalId == goalId
        && request.resource.data.status == 'replaced'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (hasNoGoalHistoryMetadata(parent)
          ? isValidGoalPointerTransition(uid, nextId)
          : isGoalReplacementWithParentUpdate(uid));
    }

    // 7-2内部作業: 設定履歴のfull検査は親user更新で一度だけ行う(P-122)。
    function isSettingsCounterChange() {
      let before = resource.data.get('judgementRevisions', null);
      let after = request.resource.data.get('judgementRevisions', null);
      return before is map && after is map
        && before.get('settings', null) != after.get('settings', null);
    }

    function isValidSettingsHistory(uid) {
      let beforeUser = resource.data;
      let afterUser = request.resource.data;
      let revision = beforeUser.judgementRevisions.settings + 1;
      let entryPath = /databases/$(database)/documents/users/$(uid)/judgementHistory/settings/entries/$(string(revision));
      let entry = getAfter(entryPath).data;
      return isGoalHistoryInitialized(beforeUser)
        && beforeUser.xPostEnabled is bool
        && afterUser.checkEnabled is bool
        && afterUser.xPostEnabled is bool
        && afterUser.judgementHistoryStartedAt == beforeUser.judgementHistoryStartedAt
        && isPositiveSafeRevision(afterUser.judgementRevisions.settings)
        && afterUser.judgementRevisions.settings == revision
        && afterUser.judgementRevisions.diff(beforeUser.judgementRevisions)
          .affectedKeys().hasOnly(['settings'])
        && !exists(entryPath)
        && entry.keys().hasOnly(['schemaVersion', 'revision', 'committedAt', 'before', 'after'])
        && entry.schemaVersion == 1
        && entry.revision is int && entry.revision == revision
        && entry.committedAt == request.time
        && entry.before == {'xPostEnabled': beforeUser.xPostEnabled}
        && entry.after == {'xPostEnabled': afterUser.xPostEnabled};
    }

    function isValidSettingsUpdate(uid, changed) {
      return hasNoGoalHistoryMetadata(resource.data)
        ? changed.hasOnly(['checkEnabled', 'xPostEnabled'])
        : (changed.hasOnly(['checkEnabled', 'xPostEnabled', 'judgementRevisions'])
          && isValidSettingsHistory(uid));
    }

    // 親settings counterの実変更を強制し、同commitの親allowにfull検査を委ねる。
    function isSettingsHistoryEntryWithParentUpdate(uid, entryId) {
      let beforeUser = get(/databases/$(database)/documents/users/$(uid)).data;
      let afterUser = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return beforeUser.judgementRevisions.settings is int
        && afterUser.judgementRevisions.settings is int
        && afterUser.judgementRevisions.settings == beforeUser.judgementRevisions.settings + 1
        && entryId == string(afterUser.judgementRevisions.settings);
    }

    // 初回・置換・数値編集の枝を維持し、設定だけ履歴付き更新へ分岐する。
    function isValidUsersUpdate(uid) {
      let after = request.resource.data;
      let changed = after.diff(resource.data).affectedKeys();
      let initial = changed.hasAny(['activeGoalId'])
        && resource.data.get('activeGoalId', null) == null;
      return (initial
          ? isValidInitialGoalRegistration(uid, after.get('activeGoalId', null), changed)
          : (changed.hasAny(['activeGoalId'])
            ? isValidGoalReplacementRegistration(uid, after.get('activeGoalId', null), changed)
            : (changed.hasAny(['judgementRevisions'])
              ? (isSettingsCounterChange()
                ? isValidSettingsUpdate(uid, changed)
                : (changed.hasOnly(['judgementRevisions']) && isValidGoalEditHistory(uid)))
              : isValidSettingsUpdate(uid, changed))))
        && (!('checkEnabled' in after) || after.checkEnabled is bool)
        && (!('xPostEnabled' in after) || after.xPostEnabled is bool);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      // users ドキュメント自体の作成(Sign in with Apple 時の初期作成)は 3-5b で扱う。ここでは既存ドキュメントの更新のみ許可する
      allow update: if canWriteUserData(uid) && isValidUsersUpdate(uid);

      match /{document=**} {
        allow read: if isOwner(uid);
      }

      // goal/settings履歴のcreateのみ。update/deleteとサーバー専用streamは禁止。
      match /judgementHistory/{stream}/entries/{entryId} {
        allow create: if canWriteUserData(uid)
          && ((stream == 'goal'
            && (isInitialGoalHistoryEntryWithParentUpdate(uid, entryId)
              || isEditedGoalHistoryEntryWithParentUpdate(uid, entryId)
              || isReplacedGoalHistoryEntryWithParentUpdate(uid, entryId)))
            || (stream == 'settings'
              && isSettingsHistoryEntryWithParentUpdate(uid, entryId)));
      }

      // 目標の新規作成(requirements 4-5, 5。数値変更での上書き・目標変更での新規作成は Phase 6)
      match /goals/{goalId} {
        allow create: if canWriteUserData(uid) && (isValidExamGoal(request.resource.data) || isValidCertGoal(request.resource.data))
          && isValidGoalCreation(uid, goalId);
        allow update: if canWriteUserData(uid) && (isValidGoalNumericUpdate(uid, goalId) || isValidGoalReplacement(uid, goalId));
      }
    }

    // Phase 3-5a 技術検証: React Native Firebase(アプリ側クライアント SDK)から
    // Emulator の Firestore に読み書きできることを確かめるための専用コレクション。
    match /devProbe/{uid} {
      allow read: if isOwner(uid);
      // 開発診断もEmulator上で本人親docをseedしてから使う。
      allow write: if canWriteUserData(uid);
    }
  }
}
